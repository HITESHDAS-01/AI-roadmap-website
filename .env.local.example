# AI Roadmap Generator - Environment Variables

# OpenAI API (get from https://platform.openai.com/api-keys)
# $5 free credit for new accounts
OPENAI_API_KEY=

# Google Gemini API (get from https://aistudio.google.com/apikey)
# Free tier available
GEMINI_API_KEY=

# Groq API (get from https://console.groq.com)
# Free tier: 30 RPM, 14,400 RPD
GROQ_API_KEY=

# SerpAPI (get from https://serpapi.com)
# 100 free searches/month
SERPAPI_KEY=

# YouTube Data API (get from https://console.developers.google.com)
# 10,000 units/day free
YOUTUBE_API_KEY=
